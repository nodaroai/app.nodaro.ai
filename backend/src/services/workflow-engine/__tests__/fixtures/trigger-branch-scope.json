    {
      "name": "a wired chain runs its descendants, not a node off the branch",
      "triggerType": "webhook",
      "triggerNodeId": "trig",
      "nodes": [
        {
          "id": "trig",
          "type": "webhook-trigger",
          "data": {}
        },
        {
          "id": "a",
          "type": "llm-chat",
          "data": {}
        },
        {
          "id": "b",
          "type": "generate-image",
          "data": {}
        },
        {
          "id": "c",
          "type": "generate-video",
          "data": {}
        }
      ],
      "edges": [
        {
          "id": "trig-a",
          "source": "trig",
          "target": "a"
        },
        {
          "id": "a-b",
          "source": "a",
          "target": "b"
        }
      ],
      "expected": [
        "a",
        "b",
        "trig"
      ]
    },
    {

              "category": "skin texture",
              "severity": "warning",
              "description": "Add visible pore detail and micro-texture variation to reduce the plastic/smooth AI sheen on the face."
            },
            {
              "category": "eyes",
              "severity": "warning",
              "description": "Increase iris texture complexity and add more natural specular highlights to eliminate the slightly glassy, frozen appearance."
            },
            {
              "category": "optics",
              "severity": "info",
              "description": "Introduce realistic lens distortion and refraction artifacts in the glasses to match true optical physics."
            }
          ]

    "notes": {
      "tighten-note-intro": {
        "text": "Tighten Episode\n\nUpload a recording, and this canvas plans a tighter cut for you. Transcribe reads the words, Silence Detect finds the dead air, and the Tighten Plan node (Cloud) decides what to trim. Apply Cut renders the result, and Add Captions burns in the remapped word-highlight captions.\n\nDrop your recording on the Episode Recording node, then Run down the chain.",
        "height": 300,
        "y": -320
      },
      "tighten-note-captions": {
        "text": "Captions are optional\n\nAdd Captions reads the REMAPPED transcript from Apply Cut (not the raw one), so the highlighted-word captions stay aligned to the tightened video. A wired transcript needs a kinetic style, so this uses Word Highlight (grouped lines, current word lit). Delete this node if you just want the clean cut.",
        "height": 240,
        "y": -300
      }
    }
  },

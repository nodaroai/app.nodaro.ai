# Nodaro self-host — example .env for docker-compose.community.yml
# Copy to .env in this directory, then: docker compose -f docker-compose.community.yml up -d
#
# Everything is OPTIONAL for local play — the compose file has working defaults.
#
# SECURITY — before exposing this stack to a network, replace the default
# JWT/anon/service keys (the defaults are public knowledge by definition):
#     node tools/generate-selfhost-keys.mjs >> .env

# ── Provider keys ─────────────────────────────────────────────────────────
# You do NOT need this file for keys: open http://localhost:3000/setup →
# Install health and paste them there (stored encrypted, live without a
# restart). Use .env when you prefer infra-as-code — a key set here WINS
# over one pasted on the screen (the tile shows "set (env)").
#
# nodaro.ai is a provider like the others. Two ways to use it, side by side
# with any other key: click "Connect nodaro.ai" in the app (OAuth sign-in,
# 1,500 free credits on a new account, per-instance spend caps), OR paste a
# personal API token from app.nodaro.ai → Settings → API (billed to that
# account). If both exist, the connected account is used.

# NODARO_API_KEY=          # nodaro.ai — every model, one account
# KIE_API_KEY=             # kie.ai — broadest media-model coverage
# REPLICATE_API_TOKEN=     # replicate.com
# ANTHROPIC_API_KEY=       # console.anthropic.com — LLM nodes
# GEMINI_API_KEY=          # aistudio.google.com — LLM + video analysis
# ELEVENLABS_API_KEY=      # elevenlabs.io — speech + voice
# FAL_KEY=                 # fal.ai
# HEYGEN_API_KEY=          # heygen.com — AI Avatar + Cinematic Avatar nodes (or connect nodaro.ai)
# BEEBLE_API_KEY=          # beeble.ai — Relight & Switch node (or connect nodaro.ai)
# APIFY_API_TOKEN=         # apify.com — Web Scrape node: Google search, site crawl, Instagram/TikTok (or connect nodaro.ai)

# ── Encryption ────────────────────────────────────────────────────────────
# Leave empty: the app generates the instance encryption key on first boot
# and keeps it in the app-data volume (back that volume up with the DB).
# Set it only if you want to bring your own (64-char hex, openssl rand -hex 32).
# NODARO_ENCRYPTION_KEY=

# ── Optional overrides ────────────────────────────────────────────────────
# PUBLIC_URL=http://localhost:3000    # change if serving on another host/port
# NODARO_CLOUD_URL=https://app.nodaro.ai

# ---------------------------------------------------------------------------
# Video editor (optional)
# ---------------------------------------------------------------------------
# Empty = the hosted editor at https://freecut.nodaro.ai, which accepts being
# embedded from localhost. If you serve this install on another origin the
# editor frame is refused by the browser — ask us to allow your origin, or run
# your own FreeCut (github.com/nodaroai/freecut, MIT) and set it here.
# Use `off` to remove the Edit-video action entirely.
# FREECUT_URL=https://freecut.example.internal

# ---------------------------------------------------------------------------
# Default language (optional)
# ---------------------------------------------------------------------------
# The locale a fresh visitor to this install starts in (he, ar, de, fr, es, hi,
# ja, ko, pt-BR, ru, zh-CN, en). A user's own saved choice always wins; an
# unset / blank / unrecognised value falls back to the visitor's browser
# language. Restart to apply.
# DEFAULT_LOCALE=he

# ---------------------------------------------------------------------------
# Deployment surface profile (optional, BUSINESS+ only)
# ---------------------------------------------------------------------------
# Inline JSON or @/path/to/profile.json. Narrows the UI without a rebuild: hide
# nav/tabs, deny nodes/models, set brand/siblings/auth, force outputs private.
# This community image IGNORES it (always serves the stock surface); it applies
# only when EDITION=business or cloud. Unset = full default surface. Example:
# NODARO_SURFACE_PROFILE={"nav":{"hide":["gallery"]},"brand":{"productName":"Studio"}}
# NODARO_SURFACE_PROFILE=

# ---------------------------------------------------------------------------
# Extra tutorial packs (optional, business / self-host)
# ---------------------------------------------------------------------------
# Comma-separated directories mounted into the container, each holding a
# manifest.json plus one *.json per tutorial. Adds tutorials to the built-in
# set — a pack never modifies the base tutorials. A malformed pack (bad JSON,
# an undeclared category, a non-public asset URL, a slug that collides with a
# base tutorial) is skipped WHOLE and logged; the base tutorials still seed.
# Mount your pack (e.g. a volume at /data/tutorials/sai) and point here at it.
# NODARO_TUTORIAL_PACKS=/data/tutorials/sai
# NODARO_TUTORIAL_PACKS=

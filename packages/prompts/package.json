{
  "name": "@nodaro/prompts",
  "version": "1.45.0",
  "description": "Nodaro's prompt-engineering layer — person/picker catalogs with prompt hints, identity-lock clauses, entity prompt builders, brand presets, and prompt/reference assembly shared by the Nodaro platform and SDK.",
  "type": "module",
  "license": "FSL-1.1-Apache-2.0",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./assembly": {
      "types": "./dist/entries/assembly.d.ts",
      "import": "./dist/entries/assembly.js",
      "require": "./dist/entries/assembly.cjs"
    },
    "./catalog-packs": {
      "types": "./dist/entries/catalog-packs.d.ts",
      "import": "./dist/entries/catalog-packs.js",
      "require": "./dist/entries/catalog-packs.cjs"
    },
    "./doctrine": {
      "types": "./dist/entries/doctrine.d.ts",
      "import": "./dist/entries/doctrine.js",
      "require": "./dist/entries/doctrine.cjs"
    },
    "./person": {
      "types": "./dist/entries/person.d.ts",
      "import": "./dist/entries/person.js",
      "require": "./dist/entries/person.cjs"
    },
    "./picker-art": {
      "types": "./dist/entries/picker-art.d.ts",
      "import": "./dist/entries/picker-art.js",
      "require": "./dist/entries/picker-art.cjs"
    },
    "./picker-catalogs": {
      "types": "./dist/entries/picker-catalogs.d.ts",
      "import": "./dist/entries/picker-catalogs.js",
      "require": "./dist/entries/picker-catalogs.cjs"
    },
    "./pickers": {
      "types": "./dist/entries/pickers.d.ts",
      "import": "./dist/entries/pickers.js",
      "require": "./dist/entries/pickers.cjs"
    },
    "./presets": {
      "types": "./dist/entries/presets.d.ts",
      "import": "./dist/entries/presets.js",
      "require": "./dist/entries/presets.cjs"
    },
    "./prompt-builder": {
      "types": "./dist/entries/prompt-builder.d.ts",
      "import": "./dist/entries/prompt-builder.js",
      "require": "./dist/entries/prompt-builder.cjs"
    },
    "./prompt-fields": {
      "types": "./dist/entries/prompt-fields.d.ts",
      "import": "./dist/entries/prompt-fields.js",
      "require": "./dist/entries/prompt-fields.cjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run"
  },
  "dependencies": {
    "@nodaro/shared": "^3.45.0"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.7.3",
    "vitest": "^4.1.2"
  },
  "engines": {
    "node": ">=22"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodaroai/app.nodaro.ai.git",
    "directory": "packages/prompts"
  },
  "homepage": "https://github.com/nodaroai/app.nodaro.ai/tree/main/packages/prompts#readme",
  "bugs": "https://github.com/nodaroai/app.nodaro.ai/issues",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "README.md",
    "src",
    "LICENSE"
  ]
}

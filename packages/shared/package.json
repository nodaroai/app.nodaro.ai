      "types": "./dist/entries/pipeline.d.ts",
      "import": "./dist/entries/pipeline.js",
      "require": "./dist/entries/pipeline.cjs"
    },
    "./scene3d": {
      "types": "./dist/entries/scene3d.d.ts",
      "import": "./dist/entries/scene3d.js",
      "require": "./dist/entries/scene3d.cjs"
    },
    "./social": {
      "types": "./dist/entries/social.d.ts",
      "import": "./dist/entries/social.js",
      "require": "./dist/entries/social.cjs"
    },
    "./types": {

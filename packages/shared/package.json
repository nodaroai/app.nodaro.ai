{
  "name": "@nodaro/shared",
  "version": "3.39.0",
  "description": "Shared types, model catalog, wire contracts, and structural vocabularies for the Nodaro platform and SDK.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nodaroai/app.nodaro.ai.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/nodaroai/app.nodaro.ai/tree/main/packages/shared#readme",
  "bugs": "https://github.com/nodaroai/app.nodaro.ai/issues",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./apps": {
      "types": "./dist/entries/apps.d.ts",
      "import": "./dist/entries/apps.js",
      "require": "./dist/entries/apps.cjs"
    },
    "./captions": {
      "types": "./dist/entries/captions.d.ts",
      "import": "./dist/entries/captions.js",
      "require": "./dist/entries/captions.cjs"
    },

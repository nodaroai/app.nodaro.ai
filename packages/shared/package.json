    "./model-catalog": {
      "types": "./dist/entries/model-catalog.d.ts",
      "import": "./dist/entries/model-catalog.js",
      "require": "./dist/entries/model-catalog.cjs"
    },
    "./models": {
      "types": "./dist/entries/models.d.ts",
      "import": "./dist/entries/models.js",
      "require": "./dist/entries/models.cjs"

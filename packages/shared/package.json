  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/metafile-*.json",
    "README.md",
    "src",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "fast-json-patch": "^3.1.1",
    "zod": "^4.4.0"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "^4.1.2",

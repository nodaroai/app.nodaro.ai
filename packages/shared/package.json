      "types": "./dist/entries/catalogs.d.ts",
      "import": "./dist/entries/catalogs.js",
      "require": "./dist/entries/catalogs.cjs"
    },
    "./credits": {
      "types": "./dist/entries/credits.d.ts",
      "import": "./dist/entries/credits.js",
      "require": "./dist/entries/credits.cjs"
    },
    "./edl": {
      "types": "./dist/entries/edl.d.ts",
      "import": "./dist/entries/edl.js",
      "require": "./dist/entries/edl.cjs"
    },
    "./entities": {
      "types": "./dist/entries/entities.d.ts",
      "import": "./dist/entries/entities.js",
      "require": "./dist/entries/entities.cjs"

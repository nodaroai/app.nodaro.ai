{
  "about": "Property fixtures for @nodaro/shared speaker-tracks (normalizeSpeakerTracks / validateSpeakerTracks). Plain data on purpose: any other implementation of the same structural rules can load this file and must agree on every case — the same normalized set, the same ok, the same issues and warnings. Times are integer ms on each SOURCE's own clock; box coordinates are fractions 0..1 of the display-oriented frame. A case with \"validateInput\": true is validated exactly as given, without normalizing first (a producer that validates its own output before any normalizer runs).",
  "edls": {
    "twoHost": {
      "version": 1,
      "clock": "master",
      "sources": [
        {
          "id": "wide",
          "url": "https://media.example/wide.mp4",
          "kind": "video",
          "role": "wide",
          "speakers": ["Host", "Guest"]
        },
        {
          "id": "camA",
          "url": "https://media.example/a.mp4",
          "kind": "video",
          "role": "camera",
          "offsetMs": 1200,
          "speakers": ["Host"]
        },
        {
          "id": "camB",
          "url": "https://media.example/b.mp4",
          "kind": "video",
          "role": "camera",
          "offsetMs": -800,
          "speakers": ["Guest"]
        },
        {"id": "mic", "url": "https://media.example/mic.wav", "kind": "audio", "role": "master-audio"}
      ],
      "segments": [
        {"id": "s0", "inMs": 0, "outMs": 4000, "video": "wide", "speaker": "Host"},
        {"id": "s1", "inMs": 4000, "outMs": 8000, "video": "camA", "speaker": "Host"},
        {"id": "s2", "inMs": 8000, "outMs": 12000, "video": "camB", "speaker": "Guest"}

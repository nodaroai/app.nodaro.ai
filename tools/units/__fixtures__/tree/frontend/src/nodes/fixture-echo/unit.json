{
  "$schema": "../../../../../../unit.schema.json",
  "schemaVersion": 1,
  "type": "fixture-echo",
  "label": "Fixture Echo",
  "category": "utility",
  "position": { "after": "upload-video" },
  "picker": { "family": "fixture-family", "after": null, "pickerCategory": "Utility", "keywords": ["echo", "fixture"] },
  "handles": {
    "inputs": [
      { "id": "in", "label": "Video", "accepts": ["video"], "field": "videoUrl" },
      { "id": "sources", "label": "Sources", "accepts": ["video", "audio"], "many": true },
      { "id": "plan", "label": "Plan", "accepts": ["look"] }
    ],
    "outputs": [{ "id": "video-out", "label": "Video", "kind": "video", "from": "generatedVideoUrl" }]
  },
  "defaultData": { "label": "Fixture Echo", "fieldMappings": {}, "size": "1K", "maxLayers": 9 },
  "execution": { "kind": "worker", "queue": "video", "requires": { "anyOf": ["videoUrl"], "kind": "video", "noun": "a video" } },
  "capabilities": ["lane:local"],
  "appFields": [
    {
      "field": "size",
      "kind": "select",
      "labelKey": "fixtureEcho.field.size",
      "options": [{ "value": "auto", "labelKey": "fixtureEcho.size.auto" }, { "value": "1K" }, { "value": "1.5K" }, { "value": "2K" }]
    },
    { "field": "maxLayers", "kind": "integer", "labelKey": "fixtureEcho.field.maxLayers", "min": 1, "max": 99, "step": 1 }
  ],
  "registry": { "description": "Echo the input video back unchanged (the gen:units fixture).", "outputType": "video" },
  "contract": { "producer": "video" },
  "docs": { "page": "docs/nodes/utility/fixture-echo.md", "useCase": "Prove every gen:units emitter" }
}

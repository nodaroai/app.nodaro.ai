{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$comment": "Editor autocomplete for frontend/src/nodes/<type>/unit.json. The authority is the validator in tools/units/manifest.mjs (gen:units fails on anything it rejects).",
  "title": "Nodaro node unit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "type",
    "label",
    "category",
    "position",
    "picker",
    "handles",
    "defaultData",
    "execution",
    "capabilities",
    "registry",
    "docs"
  ],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "schemaVersion": {
      "const": 1
    },
    "type": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9]*(?:-[a-z0-9]+)*$",
      "description": "The node type id; equals the folder name."
    },
    "label": {
      "type": "string",
      "minLength": 1
    },
    "category": {
      "enum": [
        "input",
        "parameter",
        "ai",
        "processing",
        "output",
        "scene",
        "character",
        "face",
        "object",
        "creature",
        "location",
        "utility"
      ]
    },
    "position": {
      "type": "object",
      "required": [
        "after"
      ],
      "additionalProperties": false,
      "properties": {
        "after": {
          "type": [
            "string",
            "null"
          ],
          "description": "The node type this one follows in NODE_DEFINITIONS order (null = first)."
        }
      }
    },
    "picker": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "required": [
            "family",
            "after"
          ],
          "additionalProperties": false,
          "properties": {
            "family": {
              "type": "string",
              "description": "A family id in frontend/src/lib/node-families.ts"
            },
            "after": {
              "type": [
                "string",
                "null"
              ]
            },
            "pickerCategory": {
              "type": "string"
            },
            "keywords": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "alsoOnTabs": {
              "type": "array",
              "items": {
                "enum": [
                  "image",
                  "video",
                  "audio",
                  "models",
                  "assets",
                  "automate",
                  "publish",
                  "controls"
                ]
              },
              "description": "Other picker tabs the node is also shown on (TAB_SUPERSET), besides its family's own tab."
            }
          }
        }
      ]
    },
    "handles": {
      "type": "object",
      "required": [
        "inputs",
        "outputs"
      ],
      "additionalProperties": false,
      "properties": {
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "accepts"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "accepts": {
                "type": "array",
                "minItems": 1,
                "items": {
                  "enum": [
                    "video",
                    "audio",
                    "image",
                    "look"
                  ]
                }
              },
              "field": {
                "type": "string",
                "description": "The node-data field a wired value lands in. Never on a use-case node (its inputs land in useCaseMedia / useCaseMusic / useCaseIntroCard), never with many, and never on a JSON input (accepts look: it lands in unitInputs)."
              },
              "many": {
                "const": true,
                "description": "The input takes every wire, in order, each its own source (node id + URL) in unitInputs — only on a video/audio input, never with field, never on a use-case node."
              }
            }
          }
        },
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "label",
              "kind"
            ],
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string"
              },
              "label": {
                "type": "string"
              },
              "kind": {
                "enum": [
                  "text",
                  "image",
                  "imageRef",
                  "endFrame",
                  "video",
                  "audio",
                  "audioRef",
                  "look",
                  "pickerJson",
                  "reference",
                  "identity",
                  "negative",
                  "face",
                  "mask",
                  "approve",
                  "list",
                  "variables",
                  "control"
                ]
              },
              "from": {
                "type": "string"
              },
              "runtimeTyped": {
                "const": true,
                "description": "The medium is decided at run time (contract.producer \"dynamic\"): the pip gets no HANDLE_OUTPUT_TYPES row. Only on an audio/video/image output."
              },
              "list": {
                "const": true,
                "description": "The output carries one run's list of files (an image, video or audio output with from): an Each wire runs the next node once per item (the default), a plain wire reads the first item. Its field holds the list; the job writes it under the output's id."
              }
            }
          }
        }
      }
    },
    "defaultData": {
      "type": "object"
    },
    "execution": {
      "type": "object",
      "required": [
        "kind"
      ],
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "source",
            "inline",
            "sync",
            "worker",
            "use-case"
          ]
        },
        "queue": {
          "enum": [
            "video"
          ]
        },
        "requires": {
          "type": "object",
          "required": [
            "anyOf",
            "kind",
            "noun"
          ],
          "additionalProperties": false,
          "properties": {
            "anyOf": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string"
              }
            },
            "kind": {
              "enum": [
                "text",
                "image",
                "imageRef",
                "endFrame",
                "video",
                "audio",
                "audioRef",
                "look",
                "pickerJson",
                "reference",
                "identity",
                "negative",
                "face",
                "mask",
                "approve",
                "list",
                "variables",
                "control"
              ]
            },
            "noun": {
              "type": "string"
            }
          }
        },
        "builder": {
          "type": "string",
          "description": "execution.kind \"use-case\" only (required there): its graph builder's key in USE_CASE_SPECS (packages/render-rules/src/use-case-specs.ts). Unique across units."
        }
      }
    },
    "capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Closed list: tools/units/capabilities.mjs"
    },
    "lengthUnknownReason": {
      "type": "string",
      "minLength": 1,
      "description": "Required with (and only with) the \"length:unknown\" capability: one sentence on why no rule bounds the video output's length before it has run (backend UNBOUNDED_LENGTH_REASONS)."
    },
    "registry": {
      "type": "object",
      "required": [
        "description",
        "outputType"
      ],
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1
        },
        "outputType": {
          "enum": [
            "image",
            "video",
            "audio",
            "text",
            "data",
            "none"
          ]
        },
        "after": {
          "type": [
            "string",
            "null"
          ],
          "description": "Where the node sits in /v1/nodes (NODE_REGISTRY) when that differs from position.after: right after this type (null = first). The hand-curated registry has its own order, so a migrated node keeps its place there."
        },
        "category": {
          "enum": [
            "input",
            "parameter",
            "ai-image",
            "ai-video",
            "ai-audio",
            "ai-text",
            "processing",
            "composition",
            "trigger",
            "output",
            "control",
            "entity",
            "utility"
          ],
          "description": "The /v1/nodes category (NodeCategory of backend/src/lib/node-registry.ts) of a unit whose own category is not one the server shares (ai: ai-image, ai-video, …). Refused when its category is shared."
        }
      }
    },
    "mcp": {
      "type": "object",
      "required": [
        "widgetModelFor"
      ],
      "additionalProperties": false,
      "properties": {
        "widgetModelFor": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9]*(?:_[a-z0-9]+)*$"
          },
          "description": "The MCP tools (snake_case names, e.g. gif_to_video) that dispatch this node's job and whose result widget shows this node's type as its model. Composed by backend/src/lib/mcp/widget-models.ts; a tool is claimed by one node."
        }
      }
    },
    "appFields": {
      "type": "array",
      "minItems": 1,
      "description": "The node's settings a published app may let its user set (tools/units/README.md, \"A unit's app fields\"). Each starts at its defaultData value; its labels are keys of the unit's strings.json.",
      "items": {
        "type": "object",
        "required": [
          "field",
          "kind",
          "labelKey"
        ],
        "properties": {
          "field": {
            "type": "string",
            "minLength": 1,
            "description": "The node-data field the setting writes (a key of defaultData and of the <Pascal>Data type in types.ts)."
          },
          "kind": {
            "enum": [
              "select",
              "integer"
            ],
            "description": "select: a fixed list of string values (a select card). integer: a whole number from min to max in steps of step (a slider card)."
          },
          "labelKey": {
            "type": "string",
            "description": "A key of the unit's strings.json keys: the card's label."
          },
          "options": {
            "type": "array",
            "minItems": 1,
            "description": "kind select: every value a run may take, in the order the card lists them.",
            "items": {
              "type": "object",
              "required": [
                "value"
              ],
              "additionalProperties": false,
              "properties": {
                "value": {
                  "type": "string",
                  "minLength": 1
                },
                "labelKey": {
                  "type": "string",
                  "description": "A key of the unit's strings.json keys; without one the option shows its value."
                }
              }
            }
          },
          "min": {
            "type": "integer"
          },
          "max": {
            "type": "integer"
          },
          "step": {
            "type": "integer",
            "minimum": 1
          }
        },
        "oneOf": [
          {
            "properties": {
              "kind": {
                "const": "select"
              }
            },
            "required": [
              "options"
            ],
            "not": {
              "anyOf": [
                {
                  "required": [
                    "min"
                  ]
                },
                {
                  "required": [
                    "max"
                  ]
                },
                {
                  "required": [
                    "step"
                  ]
                }
              ]
            }
          },
          {
            "properties": {
              "kind": {
                "const": "integer"
              }
            },
            "required": [
              "min",
              "max",
              "step"
            ],
            "not": {
              "required": [
                "options"
              ]
            }
          }
        ],
        "additionalProperties": false
      }
    },
    "contract": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "producer": {
          "enum": [
            "audio",
            "video",
            "image",
            "dynamic"
          ]
        },
        "jsonPips": {
          "type": "object",
          "additionalProperties": {
            "enum": [
              "transcript",
              "edl",
              "other"
            ]
          },
          "description": "What each JSON (kind \"look\") output carries: exactly the look output ids."
        },
        "nonPromptInputs": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Input handle ids that are never a prompt lane."
        },
        "reviewHold": {
          "const": true,
          "description": "execution.kind \"use-case\" only: a review-on run ends at a Preview that holds what follows."
        },
        "presents": {
          "enum": [
            "image",
            "video",
            "audio",
            "text"
          ],
          "description": "How a published app shows the result, where the producer sets do not decide it."
        },
        "fanOutEach": {
          "type": "object",
          "additionalProperties": false,
          "required": ["each", "primary"],
          "properties": {
            "each": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" }, "description": "Output ids (never a look output) an \"each\" edge reads one item at a time when the node ran once per item." },
            "primary": { "type": "string", "description": "The output id an edge naming no pip reads." }
          },
          "description": "The node's FAN_OUT_EACH_HANDLES row: which outputs carry its per-item list."
        }
      },
      "description": "Published in @nodaro/shared: never a price, prompt or doctrine."
    },
    "docs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "page": {
          "type": "string",
          "pattern": "^docs/nodes/.+\\.md$"
        },
        "awaiting": {
          "type": "string"
        },
        "useCase": {
          "type": "string"
        },
        "index": {
          "const": "hand-written",
          "description": "The node keeps its hand-written docs/nodes/README.md row, where it is (decided 2026-10-16 for migrated nodes: the public page does not change); gen:units emits no generated row for it. New nodes omit it and get a generated row."
        }
      }
    }
  }
}

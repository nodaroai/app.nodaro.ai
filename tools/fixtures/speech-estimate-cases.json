{
  "$comment": "One fixture, two engines: backend lib/speech-estimate.ts (speechEstimateChars + speechPriceUnits) and frontend lib/speech-estimate.ts must meet every case. chars = the characters the run will send as far as node data can tell; exact = literal text (false = a ceiling); units = started hundreds, at least 8; quoteId + credits = the whole request's price id and what it costs at the `pricing` block below. Caps: v3 5,000 · v4 10,000 · turbo 40,000 · dialogue 5,000 (both). `repeat` builds a string of that many copies of `of`.",
  "$pricingComment": "credits = what the server charges for the case's whole request — its `quoteId` (`<model>:per-100-chars:<N>u`): ceil(units × unit row × (100 + chargePercent) / 100), rounded ONCE on the total, as every lane reserves it. chargePercent is a test value, not any instance's. `unitRows` must equal the code's static unit rows (the backend suite checks). A client that multiplies a served one-unit price by the units quotes more than `credits` at this percent, for every case.",
  "pricing": { "chargePercent": 15, "unitRows": { "elevenlabs-v3:per-100-chars": 4, "elevenlabs-v4:per-100-chars": 4, "elevenlabs-v4-turbo:per-100-chars": 2, "elevenlabs-turbo:per-100-chars": 2, "elevenlabs-multilingual:per-100-chars": 4, "elevenlabs-dialogue:per-100-chars": 4, "elevenlabs-dialogue-v4:per-100-chars": 4 } },
  "cases": [
    { "name": "literal short on v4 — the floor", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 100, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 100, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "literal 801 on v4 — 9 started hundreds", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 801, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 801, "exact": true, "units": 9, "quoteId": "elevenlabs-v4:per-100-chars:9u", "credits": 42 } },
    { "name": "literal 2,500 on v4 Turbo — 25 started hundreds", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4-turbo", "directText": { "repeat": 2500, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4-turbo", "chars": 2500, "exact": true, "units": 25, "quoteId": "elevenlabs-v4-turbo:per-100-chars:25u", "credits": 58 } },
    { "name": "literal over the cap on v3 — clamped to 5,000", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v3", "directText": { "repeat": 6000, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v3", "chars": 5000, "exact": true, "units": 50, "quoteId": "elevenlabs-v3:per-100-chars:50u", "credits": 230 } },
    { "name": "the legacy alias runs as turbo", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs", "directText": { "repeat": 1000, "of": "a" } }, "expect": { "runsAs": "elevenlabs-turbo", "chars": 1000, "exact": true, "units": 10, "quoteId": "elevenlabs-turbo:per-100-chars:10u", "credits": 23 } },
    { "name": "an unknown model id runs as the fallback", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "not-a-model", "directText": "x" }, "expect": { "runsAs": "elevenlabs-turbo", "chars": 1, "exact": true, "units": 8, "quoteId": "elevenlabs-turbo:per-100-chars:8u", "credits": 19 } },
    { "name": "omitted model, short literal — the default model", "nodeType": "text-to-speech", "data": { "textSource": "direct", "directText": { "repeat": 100, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 100, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "omitted model, literal over the default's cap — turbo", "nodeType": "text-to-speech", "data": { "textSource": "direct", "directText": { "repeat": 12000, "of": "a" } }, "expect": { "runsAs": "elevenlabs-turbo", "chars": 12000, "exact": true, "units": 120, "quoteId": "elevenlabs-turbo:per-100-chars:120u", "credits": 276 } },
    { "name": "connected text — the model's cap", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "directText": "ignored" }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a {Reference} in the text — the cap", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "Read this: {Script}" }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a reference inside an affix — the cap", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "hello", "promptPrefix": "{Tone} " }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a field mapping onto directText — the cap", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "hello", "fieldMappings": { "directText": { "sourceNodeId": "n0" } } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a mapped provider — the default model; the literal text still counts", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-turbo", "directText": "x", "fieldMappings": { "provider": { "sourceNodeId": "p" } } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 1, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "no text at all — the cap", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4" }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "an exposed input's limit below the cap", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4" }, "ctx": { "textCap": 1200 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 1200, "exact": false, "units": 12, "quoteId": "elevenlabs-v4:per-100-chars:12u", "credits": 56 } },
    { "name": "an exposed input's limit above the cap never raises it", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v3" }, "ctx": { "textCap": 99999 }, "expect": { "runsAs": "elevenlabs-v3", "chars": 5000, "exact": false, "units": 50, "quoteId": "elevenlabs-v3:per-100-chars:50u", "credits": 230 } },
    { "name": "a literal is never shrunk by a limit", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 3000, "of": "a" } }, "ctx": { "textCap": 1200 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 3000, "exact": true, "units": 30, "quoteId": "elevenlabs-v4:per-100-chars:30u", "credits": 138 } },
    { "name": "audio tags are stripped on turbo, as the worker sends it", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-turbo", "directText": { "prefix": "[whispers] ", "repeat": 100, "of": "a" } }, "expect": { "runsAs": "elevenlabs-turbo", "chars": 100, "exact": true, "units": 8, "quoteId": "elevenlabs-turbo:per-100-chars:8u", "credits": 19 } },
    { "name": "audio tags count on v3, which performs them", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v3", "directText": { "prefix": "[whispers] ", "repeat": 100, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v3", "chars": 111, "exact": true, "units": 8, "quoteId": "elevenlabs-v3:per-100-chars:8u", "credits": 37 } },
    { "name": "a literal upstream Text node makes a connected text exact", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4" }, "ctx": { "upstreamText": { "repeat": 500, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 500, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "omitted model reads the upstream literal's length too", "nodeType": "text-to-speech", "data": { "textSource": "connected" }, "ctx": { "upstreamText": { "repeat": 12000, "of": "a" } }, "expect": { "runsAs": "elevenlabs-turbo", "chars": 12000, "exact": true, "units": 120, "quoteId": "elevenlabs-turbo:per-100-chars:120u", "credits": 276 } },
    { "name": "omitted model with unknown text — the default model's cap", "nodeType": "text-to-speech", "data": { "textSource": "connected" }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "an exposed direct text with no limit is unknown despite its default", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 200, "of": "a" } }, "ctx": { "exposed": true }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "an exposed direct text with a limit is priced at the limit", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 200, "of": "a" } }, "ctx": { "exposed": true, "textCap": 800 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 800, "exact": false, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "dialogue: literal lines are the sum, unstripped", "nodeType": "text-to-dialogue", "data": { "dialogue": [ { "text": { "repeat": 1234, "of": "a" }, "voice": "R" }, { "text": { "prefix": "[laughs] ", "repeat": 900, "of": "b" }, "voice": "G" } ] }, "expect": { "runsAs": "elevenlabs-dialogue", "chars": 2143, "exact": true, "units": 22, "quoteId": "elevenlabs-dialogue:per-100-chars:22u", "credits": 102 } },
    { "name": "dialogue: a {Reference} line — the cap", "nodeType": "text-to-dialogue", "data": { "dialogue": [ { "text": "{Script}", "voice": "R" } ] }, "expect": { "runsAs": "elevenlabs-dialogue", "chars": 5000, "exact": false, "units": 50, "quoteId": "elevenlabs-dialogue:per-100-chars:50u", "credits": 230 } },
    { "name": "dialogue v4 prices on its own model", "nodeType": "text-to-dialogue", "data": { "provider": "elevenlabs-dialogue-v4", "dialogue": [ { "text": { "repeat": 2500, "of": "a" }, "voice": "R" }, { "text": { "repeat": 2500, "of": "b" }, "voice": "G" } ] }, "expect": { "runsAs": "elevenlabs-dialogue-v4", "chars": 5000, "exact": true, "units": 50, "quoteId": "elevenlabs-dialogue-v4:per-100-chars:50u", "credits": 230 } },
    { "name": "dialogue: lines that are not an array — the cap", "nodeType": "text-to-dialogue", "data": { "dialogue": "not lines" }, "expect": { "runsAs": "elevenlabs-dialogue", "chars": 5000, "exact": false, "units": 50, "quoteId": "elevenlabs-dialogue:per-100-chars:50u", "credits": 230 } },
    { "name": "dialogue: a mapping onto the lines — the cap", "nodeType": "text-to-dialogue", "data": { "dialogue": [ { "text": "a", "voice": "R" } ], "fieldMappings": { "dialogue": { "sourceNodeId": "n0" } } }, "expect": { "runsAs": "elevenlabs-dialogue", "chars": 5000, "exact": false, "units": 50, "quoteId": "elevenlabs-dialogue:per-100-chars:50u", "credits": 230 } },
    { "name": "dialogue: an exposed input's limit caps the unknown script", "nodeType": "text-to-dialogue", "data": { "dialogue": [ { "text": "{Script}", "voice": "R" } ] }, "ctx": { "textCap": 1200 }, "expect": { "runsAs": "elevenlabs-dialogue", "chars": 1200, "exact": false, "units": 12, "quoteId": "elevenlabs-dialogue:per-100-chars:12u", "credits": 56 } },
    { "name": "direct text left blank falls through to a wired literal Text node, as the run does", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "   " }, "ctx": { "upstreamText": { "repeat": 2500, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 2500, "exact": true, "units": 25, "quoteId": "elevenlabs-v4:per-100-chars:25u", "credits": 115 } },
    { "name": "direct text left blank with an unreadable wire is unknown — the wire outranks the blank", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "" }, "ctx": { "wireUnknown": true }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "direct text left blank and nothing wired stays an exact empty text — the floor", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": "" }, "expect": { "runsAs": "elevenlabs-v4", "chars": 0, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "a typed direct text outranks a wired one", "nodeType": "text-to-speech", "data": { "textSource": "direct", "provider": "elevenlabs-v4", "directText": { "repeat": 300, "of": "a" } }, "ctx": { "wireUnknown": true, "upstreamText": { "repeat": 5000, "of": "b" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 300, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "connected with a blank wired Text node falls through to the typed text", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "directText": { "repeat": 300, "of": "a" } }, "ctx": { "upstreamText": "  " }, "expect": { "runsAs": "elevenlabs-v4", "chars": 300, "exact": true, "units": 8, "quoteId": "elevenlabs-v4:per-100-chars:8u", "credits": 37 } },
    { "name": "connected with an unreadable wire is unknown even with a typed text on the node", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "directText": { "repeat": 300, "of": "a" } }, "ctx": { "wireUnknown": true }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "connected with no readable wire and a typed text is still the cap (a fan-out may supply the text)", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "directText": { "repeat": 300, "of": "a" } }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a limit counts the pre-text the run wraps around the input", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "promptPrefix": { "repeat": 500, "of": "p" } }, "ctx": { "textCap": 1000 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 1501, "exact": false, "units": 16, "quoteId": "elevenlabs-v4:per-100-chars:16u", "credits": 74 } },
    { "name": "a limit plus the wrapped text never exceeds the model's cap", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "promptSuffix": { "repeat": 500, "of": "s" } }, "ctx": { "textCap": 9900 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } },
    { "name": "a {Reference} in a pre-text under a limit is unknown — the cap", "nodeType": "text-to-speech", "data": { "textSource": "connected", "provider": "elevenlabs-v4", "promptPrefix": "{Tone} " }, "ctx": { "textCap": 1000 }, "expect": { "runsAs": "elevenlabs-v4", "chars": 10000, "exact": false, "units": 100, "quoteId": "elevenlabs-v4:per-100-chars:100u", "credits": 460 } }

{
  "$schema": "../../../../tools/units/unit.schema.json",
  "schemaVersion": 1,
  "type": "speaker-layout",
  "label": "Speaker Layout",
  "category": "processing",
  "position": { "after": "clip-pack" },
  "picker": {
    "family": "video-podcast",
    "after": "clip-pack",
    "pickerCategory": "Processing",
    "keywords": ["podcast", "speaker", "layout", "frame", "vertical", "multicam", "camera", "whole recording"]
  },
  "handles": {
    "inputs": [
      { "id": "media", "label": "Recordings", "accepts": ["video", "audio"] },
      { "id": "masterAudio", "label": "Master audio", "accepts": ["audio"] }
    ],
    "outputs": [
      { "id": "media", "label": "Video", "kind": "video" },
      { "id": "json", "label": "Edit (EDL)", "kind": "look" }
    ]
  },
  "defaultData": { "label": "Speaker Layout", "targetAspect": "9:16", "layout": "stacked", "switchType": "cut", "emphasisStyle": "scale", "framingSource": "auto", "reviewBeforeRender": false, "fieldMappings": {}, "executionStatus": "idle" },
  "execution": { "kind": "use-case", "builder": "speakerLayout" },
  "capabilities": ["panel:generate-button", "edition:nodaro-exclusive"],
  "registry": {
    "description": "Frame a whole recording by speaker — the same length, no cut: one recording framed in turn, or several cameras of one conversation lined up with each speaker on their own camera. Its steps are priced at their own rates, plus a per-run fee.",
    "outputType": "video"
  },
  "contract": { "producer": "video", "jsonPips": { "json": "edl" }, "nonPromptInputs": ["masterAudio"], "reviewHold": true },
  "docs": {
    "page": "docs/nodes/processing-video/speaker-layout.md",
    "useCase": "A whole podcast or interview framed for 9:16 (or any shape) by speaker, nothing cut; with several cameras, each speaker on their own camera. Not yet enabled on nodaro.ai"
  }
}

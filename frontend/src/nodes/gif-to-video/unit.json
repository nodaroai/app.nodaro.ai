{
  "$schema": "../../../../tools/units/unit.schema.json",
  "schemaVersion": 1,
  "type": "gif-to-video",
  "label": "Gif to Video",
  "category": "processing",
  "position": { "after": "loop-video" },
  "picker": {
    "family": "video-format-export",
    "after": "transcode-video",
    "pickerCategory": "Processing",
    "keywords": ["gif", "mp4", "convert", "animated", "reference", "seedance", "motion"]
  },
  "handles": {
    "inputs": [{ "id": "image", "label": "GIF", "accepts": ["image"], "field": "imageUrl" }],
    "outputs": [{ "id": "video", "label": "Video", "kind": "video", "from": "generatedVideoUrl" }]
  },
  "defaultData": { "label": "Gif to Video", "loopToMinimum": true, "targetDuration": 3, "interpolate": true, "alphaBackground": "white", "fieldMappings": {} },
  "execution": {
    "kind": "worker",
    "queue": "video",
    "requires": { "anyOf": ["imageUrl", "gifUrl"], "kind": "image", "noun": "a GIF" }
  },
  "capabilities": ["panel:generate-button", "finalize:own-writer", "length:unknown", "input:entity-subject"],
  "lengthUnknownReason": "its length is the GIF's, which only the file says",
  "registry": {
    "description": "Convert an animated GIF into a widely-compatible H.264 MP4 so it can be used as a motion reference for video models that reject GIF input. Optional loop-to-minimum, seam-aware looping (ping-pong for non-seamless GIFs), and 24fps interpolation. Local FFmpeg — no provider, zero credits.",
    "outputType": "video",
    "after": "split-media"
  },
  "contract": { "producer": "video" },
  "mcp": { "widgetModelFor": ["gif_to_video"] },
  "docs": {
    "page": "docs/nodes/processing-video/gif-to-video.md",
    "index": "hand-written",
    "useCase": "Turn a GIF into an MP4 motion reference for video models that reject GIF input (local FFmpeg)"
  }
}

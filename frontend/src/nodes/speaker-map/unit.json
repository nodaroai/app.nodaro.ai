{
  "$schema": "../../../../tools/units/unit.schema.json",
  "schemaVersion": 1,
  "type": "speaker-map",
  "label": "Speaker Map",
  "category": "processing",
  "position": {
    "after": "remove-audio"
  },
  "picker": {
    "family": "audio-analyze",
    "after": "audio-sync",
    "keywords": ["speaker map", "who is on camera", "multicam", "podcast", "camera", "speaker", "diarization"]
  },
  "handles": {
    "inputs": [
      { "id": "sources", "label": "Cameras", "accepts": ["video", "audio"], "many": true },
      { "id": "offsets", "label": "Offsets", "accepts": ["look"] },
      { "id": "transcript", "label": "Transcript", "accepts": ["look"] }
    ],
    "outputs": [
      { "id": "json", "label": "Speaker map", "kind": "look", "from": "generatedJson" },
      { "id": "edl", "label": "Edit (EDL)", "kind": "look", "from": "generatedEdl" }
    ]
  },
  "defaultData": {
    "label": "Speaker Map",
    "fieldMappings": {}
  },
  "execution": {
    "kind": "worker",
    "queue": "video"
  },
  "capabilities": ["panel:generate-button", "finalize:own-writer"],
  "registry": {
    "description": "Work out which camera each speaker is on, from the cameras' own microphones: 2–6 recordings, their Audio Sync offsets and a diarized transcript.",
    "outputType": "data"
  },
  "contract": {
    "jsonPips": { "json": "other", "edl": "edl" }
  },
  "docs": {
    "page": "docs/nodes/processing-audio/speaker-map.md",
    "useCase": "Tell Camera Switch whose camera is whose in a multicam podcast, without filling in the speaker table by hand"
  }
}

{
  "$schema": "../../../../tools/units/unit.schema.json",
  "schemaVersion": 1,
  "type": "clip-pack",
  "label": "Clip Pack",
  "category": "processing",
  "position": { "after": "episode-trailer" },
  "picker": {
    "family": "video-podcast",
    "after": "episode-trailer",
    "pickerCategory": "Processing",
    "keywords": ["podcast", "clips", "shorts", "reels", "highlights", "social", "vertical", "captions", "one step"],
    "alsoOnTabs": ["audio"]
  },
  "handles": {
    "inputs": [
      { "id": "media", "label": "Recordings", "accepts": ["video", "audio"] },
      { "id": "masterAudio", "label": "Master audio", "accepts": ["audio"] }
    ],
    "outputs": [
      { "id": "clips", "label": "Clips", "kind": "video", "runtimeTyped": true },
      { "id": "json", "label": "Clip set (EDLs)", "kind": "look" }
    ]
  },
  "defaultData": { "label": "Clip Pack", "count": 8, "targetDurationSec": 60, "framing": { "aspect": "9:16", "layout": "stacked", "switchType": "pan", "emphasisStyle": "scale" }, "captions": true, "captionStyle": "karaoke", "reviewBeforeRender": false, "planTier": "standard", "framingSource": "auto", "instructions": "", "fieldMappings": {}, "executionStatus": "idle" },
  "execution": { "kind": "use-case", "builder": "clipPack" },
  "capabilities": ["panel:generate-button", "edition:nodaro-exclusive"],
  "registry": {
    "description": "Cut a podcast recording into a pack of short clips in one step: finds the best moments, renders each (framed for 9:16 by default) with captions. Each clip is a separate result. Its steps are priced at their own rates, plus a per-run fee.",
    "outputType": "video"
  },
  "contract": { "producer": "dynamic", "jsonPips": { "json": "edl" }, "nonPromptInputs": ["masterAudio"], "reviewHold": true, "presents": "video", "fanOutEach": { "each": ["clips"], "primary": "clips" } },
  "docs": { "page": "docs/nodes/processing-video/clip-pack.md", "index": "hand-written" }
}

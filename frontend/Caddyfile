{
	# Caddy global config. Updated 2026-04-29 — force redeploy after
	# /.well-known/oauth-* handle blocks were added.
	auto_https off
	admin off
}

:3000 {
	# Security headers (no X-Frame-Options — app supports iframe embedding)
	header {
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(self), geolocation=()"
	}

	handle /v1/* {
		# Strip any attempt by an external client to spoof internal-orchestrator
		# auth headers. Backend authenticates internal calls via a shared secret,
		# but stripping here is defense-in-depth — if the secret ever leaks,
		# externally-forwarded headers still can't reach the backend.
		request_header -X-Internal-Orchestrator
		request_header -X-Internal-Orchestrator-Secret
		reverse_proxy 127.0.0.1:9000 {
			# Disable response buffering for SSE streams
			flush_interval -1
		}
	}

	# OAuth discovery endpoints (RFC 8414 + RFC 9728) MUST be served by the
	# backend, not the SPA fallback. Without this, MCP clients (Claude.ai etc.)
	# probing app.nodaro.ai/.well-known/oauth-authorization-server get HTML
	# back and can't parse it — the OAuth handshake fails before it starts.
	handle /.well-known/oauth-authorization-server {
		request_header -X-Internal-Orchestrator
		request_header -X-Internal-Orchestrator-Secret
		reverse_proxy 127.0.0.1:9000
	}
	handle /.well-known/oauth-protected-resource {
		request_header -X-Internal-Orchestrator
		request_header -X-Internal-Orchestrator-Secret
		reverse_proxy 127.0.0.1:9000
	}
	# RFC 9728 §3.1 — resource-specific variants. Cursor probes these FIRST
	# for path-suffixed resources (mcp.nodaro.ai/mcp). Without these handles
	# Caddy sends them through the SPA fallback, returning HTML, and Cursor
	# flaps into needsAuth.
	handle /.well-known/oauth-protected-resource/* {
		request_header -X-Internal-Orchestrator
		request_header -X-Internal-Orchestrator-Secret
		reverse_proxy 127.0.0.1:9000
	}
	handle /.well-known/oauth-authorization-server/* {
		request_header -X-Internal-Orchestrator
		request_header -X-Internal-Orchestrator-Secret
		reverse_proxy 127.0.0.1:9000
	}

	# The MCP endpoint lives on the mcp.* host (Railway routes that domain
	# straight to the backend port — this listener never sees it). A client
	# POSTing /mcp on the app domain is a misconfigured MCP connector, and
	# file_server's bare bodyless 405 gave it no clue why (real incident:
	# connectors created with app.nodaro.ai/mcp can never work and failed
	# silently). Keep GET/HEAD — /mcp is the marketing landing page in the
	# SPA — but answer every other method with a machine-readable pointer
	# to the real endpoint. Same 405 status as before, now with a body.
	@mcp_wrong_host {
		path /mcp /mcp/
		not method GET HEAD
	}
	handle @mcp_wrong_host {
		header Content-Type "application/json"
		respond `{"error":{"code":"wrong_mcp_host","message":"The MCP endpoint is not served on this host. Point your MCP client at {$MCP_PUBLIC_URL:https://mcp.nodaro.ai}/mcp"}}` 405
	}

	# OG meta tags for social sharing bots (Telegram, WhatsApp, Twitter, Facebook, etc.)
	@social_bot {
		path /app/*
		header_regexp User-Agent (?i)(telegrambot|whatsapp|twitterbot|facebookexternalhit|linkedinbot|slackbot|discordbot|pinterestbot|applebot|googlebot|bingbot)
	}
	handle @social_bot {
		rewrite * /og{uri}
		reverse_proxy 127.0.0.1:9000
	}

	# Self-host media path: proxies the bundled MinIO so ONE origin serves both
	# the app and stored media. R2_PUBLIC_URL=http://localhost:3000/storage/<bucket>
	# works from the browser AND from server-side fetches inside this container
	# (localhost:3000 = this Caddy), which localhost:9000-style URLs cannot do
	# (in-container that port is the backend itself). handle_path strips the
	# /storage prefix, so MinIO sees the path-style /<bucket>/<key>. On cloud
	# deploys nothing references /storage/* and no `minio` host exists — the
	# route is dead weight, resolved lazily per request, never at boot.
	handle_path /storage/* {
		header Cache-Control "public, max-age=31536000, immutable"
		reverse_proxy {$MINIO_UPSTREAM:minio:9000}
	}

	# Self-host Supabase path: SUPABASE_URL=http://localhost:3000/supabase, and
	# supabase-js appends /auth/v1 + /rest/v1 to it. These routes play the role
	# Kong plays in the official Supabase compose — strip the prefix and hand
	# GoTrue/PostgREST the bare path (both serve at their root). GoTrue and
	# PostgREST validate the JWTs themselves, so no gateway key-auth layer is
	# needed. Same one-origin trick as /storage/*: browser AND backend share
	# the URL. Realtime is not bundled (the app's polling covers job updates);
	# supabase-js retries its websocket quietly against the 502. Dead routes on
	# cloud — upstreams resolve lazily, never at boot.
	handle_path /supabase/auth/v1/* {
		reverse_proxy {$SUPABASE_AUTH_UPSTREAM:auth:9999}
	}
	handle_path /supabase/rest/v1/* {
		reverse_proxy {$SUPABASE_REST_UPSTREAM:rest:3000}
	}

	# Bust stale CDN cache for favicon.ico by rewriting to a versioned file
	rewrite /favicon.ico /favicon-v11.ico
	# Runtime config, written by start.sh at boot from the container's env.
	# Never cacheable: a changed PUBLIC_URL must reach the next page load, and
	# the immutable @static header below must not apply to it.
	handle /config.js {
		root * /app/frontend/dist
		header Cache-Control "no-store"
		file_server
	}
	handle {
		# zstd + gzip: Caddy negotiates the best supported encoding per request.
		# zstd shaves ~15-25% more off JS/CSS than gzip alone.
		encode zstd gzip
		root * /app/frontend/dist
		try_files {path} /index.html
		file_server
	}
	@static {
		path *.js *.css *.png *.svg *.woff2
		not path /config.js
	}
	header @static Cache-Control "public, max-age=31536000, immutable"
	@favicon path *.ico
	header @favicon Cache-Control "public, max-age=86400"

	# The SPA shell (index.html) must always be revalidated. try_files serves
	# index.html for the bare path "/", any *.html, and every extensionless SPA
	# route (/editor, /gallery, /app/abc, …). A stale shell could point at
	# deleted hashed chunks; the vite:preloadError reload machinery relies on
	# the HTML never being cached by an intermediary.
	#
	# `^[^.]*$` matches paths with no dot (the SPA routes) and `/.*\.html$`
	# matches .html files — both disjoint from the hashed *.js/*.css/*.png/etc.
	# assets above, which keep their 1yr immutable header.
	@html path_regexp html ^([^.]*|/.*\.html)$
	header @html Cache-Control "no-cache"
}

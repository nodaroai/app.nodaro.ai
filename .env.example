# ============================================================================
# Nodaro — Environment Variable Reference
# ============================================================================
# Copy this file to .env and fill in values for your instance.
#
# Required vars are marked [REQUIRED]. Optional vars have sensible defaults.
# See docs/deployment.md for a full guide.
# ============================================================================

# --- Edition ----------------------------------------------------------------
# community = OSS, no admin / credits / billing
# business  = self-hosted with admin + user mgmt
# cloud     = full SaaS with credits + Stripe
EDITION=community

# --- App URL & CORS --------------------------------------------------------
# Public-facing URL for OAuth redirects, OG tags, embed links, and the deep
# links baked into MCP tool responses/widgets. Also this deployment's IDENTITY
# for background drivers that scan a database shared between deployments
# (e.g. the recast driver: a run is stepped only by the deployment whose
# PUBLIC_URL created it — staging and production sharing one DB each drive
# their own runs). RECAST_DRIVER_ORIGIN overrides it for that purpose alone.
# In production, set to your instance's HTTPS URL (e.g. https://nodaro.example.com).
PUBLIC_URL=http://localhost:3000

# Public base URL of the MCP host, if you enable MCP (see MCP_ENABLED below).
# Drives the RFC 9728 protected-resource identity and MCP upload links. Set it
# to the domain your MCP clients connect to (e.g. https://mcp.nodaro.example.com,
# or the same value as PUBLIC_URL when MCP is served from the main host).
# Leave empty on Nodaro Cloud.
MCP_PUBLIC_URL=

# Cloud-connect (self-hosted instances <-> Nodaro Cloud). See docs/deployment.md §11.
# On YOUR instance: which cloud the "Connect nodaro.ai" button registers with.
# Empty = https://app.nodaro.ai. Use https://next.nodaro.ai for a staging soak.
NODARO_CLOUD_URL=
# On YOUR instance: nodaro.ai as a provider via a personal API token from
# app.nodaro.ai -> Settings -> API (billed to that account). Alternative to
# the OAuth "Connect nodaro.ai" flow; the connected account wins if both exist.
NODARO_API_KEY=
# On a CLOUD-edition deployment only: accept registrations from self-hosted
# instances (and show the Connected Instances page). Read at boot. Default false.
# COMMUNITY_CONNECT_ENABLED=true

# Comma-separated list of additional allowed CORS origins. localhost:3000 and
# localhost:5173 are always included for dev.
CORS_ORIGIN=

# --- Supabase ---------------------------------------------------------------
# OPTIONAL with docker-compose.community.yml: the compose bundles a full
# Supabase stack (Postgres + GoTrue + PostgREST) with working defaults, and
# migrations apply themselves on first boot. Before exposing the stack to a
# network, mint fresh keys: node tools/generate-selfhost-keys.mjs >> .env
# (all three values must come from the same run).
#
# To use a MANAGED supabase.com project instead, set all three below and set
# RUN_MIGRATIONS_ON_BOOT=false (apply supabase/migrations/ via the SQL editor
# or CLI). [REQUIRED] when running the backend outside the community compose.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...
# Anon key (public, used by frontend to talk to Supabase Auth + RLS-gated endpoints)
SUPABASE_ANON_KEY=eyJ...
# Bundled-stack extras (community compose only; defaults work out of the box):
# SUPABASE_JWT_SECRET=   POSTGRES_PASSWORD=   DATABASE_URL=
# RUN_MIGRATIONS_ON_BOOT=true

# --- Redis [REQUIRED for workflow execution] --------------------------------
REDIS_URL=redis://localhost:6379

# --- Storage (S3-compatible) -------------------------------------------------
# Required for asset uploads. Two modes:
#
# 1. Bundled MinIO (docker-compose.community.yml default) — zero cloud
#    accounts, media lands on your disk. The compose file already ships
#    working defaults for all of these; you only need to set them here if
#    you run the backend outside compose:
#      R2_ENDPOINT=http://minio:9000        (custom S3 endpoint)
#      R2_FORCE_PATH_STYLE=true             (MinIO needs path-style addressing)
#      R2_PUBLIC_URL=http://localhost:3000/storage/nodaro-assets
#    The bucket is auto-created (with public read) on boot.
#
# 2. Cloudflare R2 — set R2_ACCOUNT_ID + keys and leave R2_ENDPOINT /
#    R2_FORCE_PATH_STYLE empty; the endpoint is derived from the account id.
R2_ENDPOINT=
R2_FORCE_PATH_STYLE=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=nodaro-assets
R2_PUBLIC_URL=
# S3 region. "auto" is Cloudflare R2's own value and MinIO ignores the field,
# but AWS, DigitalOcean Spaces ("nyc3", …) and Supabase-local ("local")
# validate it and reject "auto". Leave empty for R2/MinIO.
R2_REGION=
# Optional: extra bucket hostname to allow in the /v1/download + /v1/image-proxy
# allowlist, in addition to the origin derived from R2_PUBLIC_URL. Only needed
# if assets are served from a second host (e.g. a raw pub-<id>.r2.dev bucket
# host alongside a custom CDN domain). Leave empty otherwise.
R2_PUBLIC_FALLBACK_DOMAIN=
# Canned ACL stamped on every object this app writes. EMPTY = the header is
# omitted entirely, which is what every install does today: Cloudflare R2 is
# public by bucket setting, and a custom endpoint gets an anonymous-read
# BUCKET POLICY applied at boot. Set this only for stores that cannot take a
# bucket policy — DigitalOcean Spaces refuses PutBucketPolicy to a
# bucket-scoped key, so per-object ACLs are the only way there:
#      STORAGE_OBJECT_ACL=public-read
STORAGE_OBJECT_ACL=

# --- AI Providers (at least one recommended) --------------------------------
KIE_API_KEY=
# Optional: send KIE traffic somewhere else — typically an egress proxy that
# holds the real key (key custody, audit logging, regional routing). Empty =
# https://api.kie.ai. NOTE this also moves the KIE-fronted LLM lanes (Claude,
# Gemini), so the proxy must serve /claude/v1/messages and
# /<family>/v1/chat|responses as well as /api/v1. See docs/deployment.md 12a.
KIE_API_BASE_URL=
REPLICATE_API_TOKEN=
# Required in Cloud edition for character LoRA training webhook signature
# verification (Standard Webhooks HMAC). Get from
# `replicate.webhooks.default.secret` or the Replicate dashboard.
REPLICATE_WEBHOOK_SECRET=
# Operational kill-switch for the character LoRA inference path. When "false",
# trained-character generations fall back to standard reference-image
# injection. Training routes are unaffected. Default: true.
# CHARACTER_LORA_ROUTING_ENABLED=true
ANTHROPIC_API_KEY=
# Google Gemini API key — https://aistudio.google.com/apikey
# Enables the direct-Google lane for models declaring `directGeminiModel`
# (see packages/shared/src/llm-models.ts). Optional: when empty, every Gemini
# model is served through KIE. Distinct from the GOOGLE_CLIENT_ID /
# GOOGLE_CLIENT_SECRET pair below, which is OAuth login only.
GEMINI_API_KEY=
ELEVENLABS_API_KEY=
# Optional: same egress-proxy idea for ElevenLabs. Empty = https://api.elevenlabs.io
ELEVENLABS_BASE_URL=
APIFY_API_TOKEN=
# Optional — enables fal.ai-hosted models (e.g. Sync Lipsync v3 lip-sync).
# When empty, fal models are inert; the rest of the app is unaffected.
FAL_KEY=

# KIE.ai account unique ID for the credit-audit API (constant per account).
# Only needed if you want admin credit-audit reports.
KIE_UNIQUE_ID=

# --- Internal secrets [REQUIRED] -------------------------------------------
# Generate: openssl rand -hex 32
INTERNAL_ORCHESTRATOR_SECRET=

# Instance encryption key — every secret the server stores for itself
# (provider keys pasted on /setup, social OAuth tokens). 64-char hex.
# Generate: openssl rand -hex 32. Managed deployments MUST set it (a key
# that changes across deploys makes every stored secret unreadable); the
# community compose stack generates one on first boot when it is empty.
# SOCIAL_ENCRYPTION_KEY is the older name and is still accepted.
NODARO_ENCRYPTION_KEY=
SOCIAL_ENCRYPTION_KEY=

# --- Server tuning (optional) -----------------------------------------------
PORT=8000
HOST=0.0.0.0
NODE_ENV=development

# Concurrency limits
MAX_CONCURRENT_NODES_PER_EXECUTION=6
VIDEO_WORKER_CONCURRENCY=50
ORCHESTRATOR_CONCURRENCY=20
RENDER_WORKER_CONCURRENCY=2
FFMPEG_CONCURRENCY=4

# Number of parallel browser tabs for Remotion renders.
# Leave unset to use Remotion's default (50% of CPU cores).
# REMOTION_CONCURRENCY=

# --- Admin owner gate (business / cloud, optional) --------------------------
# Email of the platform owner whose super_admin role is protected from changes
# by other admins. Empty (default) = no protected owner. Set the SAME value in
# the frontend build arg VITE_PLATFORM_OWNER_EMAIL for the matching UI guard.
PLATFORM_OWNER_EMAIL=

# --- Stripe (cloud edition only) --------------------------------------------
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
#
# NOTE: Stripe product/price IDs are currently hardcoded in
# backend/src/ee/billing/stripe-config.ts and frontend/src/lib/pricing-data.ts.
# Self-hosted Cloud operators must replace those with their own Stripe IDs.
# (Tracked for migration to env vars — see the OSS-readiness audit.)

# --- Social OAuth (optional, per platform) ----------------------------------
# Required only if social-publishing nodes are used.
# META_APP_ID=
# META_APP_SECRET=
# META_FACEBOOK_CONFIG_ID=
# META_INSTAGRAM_CONFIG_ID=
# TIKTOK_CLIENT_KEY=
# TIKTOK_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# X_CLIENT_ID=
# X_CLIENT_SECRET=

# --- Frontend Vite vars (set during Docker build, prefix VITE_) -------------
# Inlined at build time — EXCEPT the API URL / Supabase URL / anon key: the
# published community image rewrites those at BOOT into /config.js (from
# PUBLIC_URL, FRONTEND_SUPABASE_URL and SUPABASE_ANON_KEY above), so one image
# serves any origin without a rebuild.
# VITE_API_URL=http://localhost:8000
# VITE_EDITION=community
# VITE_SUPABASE_URL=
# VITE_SUPABASE_ANON_KEY=
# Supabase URL the BROWSER should use when it differs from the backend's
# SUPABASE_URL (managed project / custom domain); written into /config.js.
# FRONTEND_SUPABASE_URL=
# The locale a fresh visitor to this install starts in (he, ar, de, fr, es, …);
# a user's saved choice always wins, blank/unknown = browser detection. Written
# into /config.js at boot; restart to apply.
# DEFAULT_LOCALE=
# VITE_APP_URL=
# VITE_STRIPE_PUBLISHABLE_KEY=
# VITE_FREECUT_URL=
# VITE_AUDIOMASS_URL=
# Optional analytics (empty = disabled; nothing phones home). Set only if you
# want to send telemetry to YOUR OWN Google Analytics / Microsoft Clarity.
# VITE_GA_ID=
# VITE_CLARITY_ID=
# Owner gate UI (match backend PLATFORM_OWNER_EMAIL). Empty = no protected owner.
# VITE_PLATFORM_OWNER_EMAIL=
